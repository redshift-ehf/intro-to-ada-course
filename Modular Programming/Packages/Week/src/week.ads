--  A package specification. It declares what exists; it does not say how anything works.
--
--  These are constants, so there is nothing to implement and this package needs no body at all.
package Week is

   Mon : constant String := "Monday";
   Tue : constant String := "Tuesday";
   Wed : constant String := "Wednesday";
   Thu : constant String := "Thursday";
   Fri : constant String := "Friday";
   Sat : constant String := "Saturday";
   Sun : constant String := "Sunday";

end Week;
