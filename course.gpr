--  The whole course is one GNAT project.
--
--  Every exercise shares this file rather than carrying a crate of its own, which is not a
--  compromise: `gprbuild -P course.gpr <one_main>.adb` compiles that main's closure and nothing
--  else, so an exercise you have not finished yet cannot break the ones you have. And because
--  there is a single project, the language server keeps every lesson navigable at once —
--  go-to-definition works from any file to any other, which it would not with a project per task.
--
--  Source_Dirs names each section explicitly. A single "**" at the root also works (measured), but
--  listing the sections says what belongs to the course and what is incidental, and it means a
--  stray directory cannot quietly become course content.
--
--  The directory names carry spaces because they are also the section titles the student sees —
--  JetBrains Academy takes lesson and section titles from the directory name, and only tasks can
--  override it. GPR accepts them; that was measured before this file was written.
project Course is

   --  C as well as Ada, for the Interfacing With C chapter. Nothing else in the course has a C
   --  source, and this costs the rest of it nothing -- gprbuild simply finds none to compile.
   --
   --  It does mean a C compiler is now required to build the course. That is not a new
   --  dependency in practice: GNAT *is* GCC, and the Alire toolchain the README recommends
   --  ships gcc beside gnatmake. Checked before adding this line.
   for Languages use ("Ada", "C");

   --  One entry per section, added as each section lands. gprbuild rejects a directory that does
   --  not exist, so this list cannot drift ahead of the course -- adding a section means adding it
   --  here, and forgetting is a build failure rather than a mystery.
   for Source_Dirs use
     ("harness",
      "Imperative Language/**",
      "Subprograms/**",
      "Modular Programming/**",
      "Strongly Typed Language/**",
      "Records/**",
      "Arrays/**",
      "More About Types/**",
      "Access Types/**",
      "More About Records/**",
      "Fixed-Point Types/**",
      "Privacy/**",
      "Generics/**",
      "Exceptions/**",
      "Tasking/**",
      "Design By Contracts/**",
      "Interfacing With C/**",
      "Object Oriented Programming/**",
      "Standard Library Containers/**",
      "Standard Library Dates And Times/**");

   for Object_Dir use "obj";
   for Exec_Dir use "bin";

   --  Every task source that is a runnable program: the theory examples, and any exercise whose
   --  subprogram takes no arguments. Ada's rule for a main is a parameterless library-level
   --  subprogram, and the IDE puts a Run button beside exactly those -- so a file that is one and
   --  is missing here gets a button that fails. Say_Hello is precisely that case, and
   --  check_course.py now refuses to pass if this list and that rule ever disagree again.
   --
   --  The exercises that DO take arguments are absent because they cannot be mains, which is also
   --  why they get no Run button, only Check.
   --
   --  Declaring these does not cost the per-exercise isolation described above. That comes from
   --  naming one main on the command line, which works whatever this list says; all this changes
   --  is what a bare `gprbuild -P course.gpr` builds. Checked with an unfinished exercise in the
   --  tree: the bare build succeeds and produces exactly the list below, because an exercise is
   --  not a main and nothing here withs it.
   for Main use
     ("greet.adb",
      "say_hello.adb",
      "check_direction.adb",
      "counting.adb",
      "compass.adb",
      "scope.adb",
      "parity.adb",
      "increment.adb",
      "swap.adb",
      "show_renaming.adb",
      "show_week.adb",
      "show_package_renaming.adb",
      "show_types.adb",
      "show_integers.adb",
      "show_modular.adb",
      "show_days.adb",
      "show_floats.adb",
      "show_distances.adb",
      "show_derived_types.adb",
      "show_subtypes.adb",
      "show_records.adb",
      "show_aggregates.adb",
      "show_selection.adb",
      "show_component_renaming.adb",
      "show_arrays.adb",
      "show_indexing.adb",
      "show_simple_bounds.adb",
      "show_array_attributes.adb",
      "show_unconstrained.adb",
      "show_strings.adb",
      "show_returning_arrays.adb",
      "show_slices.adb",
      "show_array_renaming.adb",
      "show_aggregate_forms.adb",
      "show_qualified_expressions.adb",
      "show_character_types.adb",
      "show_access_types.adb",
      "show_allocation.adb",
      "show_dereferencing.adb",
      "show_deallocation.adb",
      "show_recursive_types.adb",
      "show_dynamic_records.adb",
      "show_discriminants.adb",
      "show_variant_records.adb",
      "show_decimal_fixed_point.adb",
      "show_ordinary_fixed_point.adb",
      "show_fixed_versus_float.adb",
      "show_encapsulation.adb",
      "show_private_types.adb",
      "show_limited_types.adb",
      "show_generics.adb",
      "show_formal_types.adb",
      "show_formal_objects.adb",
      "show_generic_body.adb",
      "show_instantiation.adb",
      "show_generic_packages.adb",
      "show_formal_subprograms.adb",
      "show_exception_declaration.adb",
      "show_raising.adb",
      "show_handling.adb",
      "show_predefined_exceptions.adb",
      "show_simple_task.adb",
      "show_synchronization.adb",
      "show_delay.adb",
      "show_rendezvous.adb",
      "show_select_loop.adb",
      "show_cycling_tasks.adb",
      "show_protected_objects.adb",
      "show_protected_entries.adb",
      "show_task_types.adb",
      "show_protected_types.adb",
      "show_preconditions.adb",
      "show_predicates.adb",
      "show_type_invariants.adb",
      "show_multi_language.adb",
      "show_c_types.adb",
      "show_foreign_subprograms.adb",
      "show_foreign_variables.adb",
      "show_bindings.adb",
      "show_extension.adb",
      "show_tagged_types.adb",
      "show_classwide_types.adb",
      "show_dispatching.adb",
      "show_dot_notation.adb",
      "show_oop_privacy.adb",
      "show_classwide_access.adb",
      "show_vector_inst.adb",
      "show_vector_init.adb",
      "show_vector_append.adb",
      "show_vector_first_last.adb",
      "show_vector_iteration.adb",
      "show_vector_find.adb",
      "show_vector_insert.adb",
      "show_vector_remove.adb",
      "show_vector_ops.adb",
      "show_set_init.adb",
      "show_set_element_ops.adb",
      "show_set_ops.adb",
      "show_hashed_map.adb",
      "show_ordered_map.adb",
      "show_complexity.adb",
      "show_calendar.adb",
      "show_delay_until_date.adb",
      "show_real_time.adb",
      "show_benchmarking.adb");

   package Compiler is
      --  -gnatwa: warn about everything worth warning about. A course should teach the habit of
      --  reading warnings, and Ada's are unusually good.
      --
      --  -gnata: check assertions, which for Ada 2012 means Pre, Post, Static_Predicate,
      --  Dynamic_Predicate and Type_Invariant as well as pragma Assert. GNAT ignores every one
      --  of those at run time without it -- measured before this was added: a function with
      --  `Pre => X mod 2 = 0` accepted 3 and returned 1, in silence. The Design by Contracts
      --  chapter would have been decorative, and its exercises would have passed while proving
      --  nothing. It is on for the whole course rather than one chapter because a check that is
      --  only sometimes enabled is worse than one that is always on or always off.
      for Default_Switches ("Ada") use ("-g", "-gnatwa", "-gnata");
   end Compiler;

end Course;
